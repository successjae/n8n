[
  {
    "name": "theme_info",
    "theme_name": "Peace Beloved",
    "theme_version": "1.0.0",
    "theme_author": "Peace Beloved Clothing",
    "theme_documentation_url": "https://peacebelovedclothing.com",
    "theme_support_url": "https://peacebelovedclothing.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      },
      {
        "type": "text",
        "id": "brand_statement",
        "label": "Brand statement",
        "default": "Take the unloved and make it beloved."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_blue", "label": "Royal blue", "default": "#0057B8" },
      { "type": "color", "id": "color_orange", "label": "Orange", "default": "#F58426" },
      { "type": "color", "id": "color_cream", "label": "Cream", "default": "#F7F2EA" },
      { "type": "color", "id": "color_black", "label": "Black", "default": "#101010" },
      { "type": "color", "id": "color_white", "label": "White", "default": "#FFFFFF" },
      { "type": "color", "id": "color_gray", "label": "Warm gray", "default": "#E7E2D9" },
      { "type": "color", "id": "color_dark_blue", "label": "Dark blue", "default": "#003B7A" },
      { "type": "color", "id": "color_soft_orange", "label": "Soft orange", "default": "#FFB36A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "helvetica_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "helvetica_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1400
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Enable quick add",
        "default": true
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable scroll & intro animations",
        "default": true
      }
    ]
  },
  {
    "name": "Newsletter",
    "settings": [
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Footer newsletter heading",
        "default": "Join the Beloved List"
      },
      {
        "type": "text",
        "id": "newsletter_text",
        "label": "Footer newsletter text",
        "default": "Get first access to new drops, restocks, and exclusive brand updates."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL", "info": "e.g. https://instagram.com/peacebelovedclothing" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "url", "id": "social_twitter", "label": "X / Twitter URL" },
      { "type": "url", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_instagram_handle", "label": "Instagram handle", "default": "@PeaceBelovedClothing" }
    ]
  }
]
