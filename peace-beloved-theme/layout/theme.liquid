<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="theme-color" content="{{ settings.color_blue }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_body_font == blank -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta name="twitter:card" content="summary_large_image">

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
    -%}

    {% style %}
      {% unless settings.type_body_font == blank %}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
        {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
      {% endunless %}
      {% unless settings.type_heading_font == blank %}
        {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      {% endunless %}

      :root {
        --pb-blue: {{ settings.color_blue }};
        --pb-orange: {{ settings.color_orange }};
        --pb-cream: {{ settings.color_cream }};
        --pb-black: {{ settings.color_black }};
        --pb-white: {{ settings.color_white }};
        --pb-gray: {{ settings.color_gray }};
        --pb-dark-blue: {{ settings.color_dark_blue }};
        --pb-soft-orange: {{ settings.color_soft_orange }};

        --pb-page-width: {{ settings.page_width }}px;
        --pb-btn-radius: {{ settings.button_radius }}px;

        {%- unless body_font == blank -%}
          --pb-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
          --pb-font-body-weight: {{ body_font.weight }};
        {%- endunless -%}
        {%- unless heading_font == blank -%}
          --pb-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
          --pb-font-heading-weight: {{ heading_font.weight }};
        {%- endunless -%}
      }

      {%- unless settings.animations_enabled -%}
        :root { --pb-anim-state: paused; }
        .pb-reveal { opacity: 1 !important; transform: none !important; }
      {%- endunless -%}
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="pb-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'header-beloved' %}

    <main id="MainContent" class="pb-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer-beloved' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
  </body>
</html>
