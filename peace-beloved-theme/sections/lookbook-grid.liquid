{%- comment -%} Peace Beloved — Editorial lookbook grid {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container pb-container--wide">
    <div class="pb-section__head pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="pb-section__subhead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="pb-lookbook">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign item_class = 'pb-lookbook__item pb-reveal' -%}
        {%- if b.size == 'tall' -%}{%- assign item_class = item_class | append: ' pb-lookbook__item--tall' -%}{%- endif -%}
        {%- if b.size == 'wide' -%}{%- assign item_class = item_class | append: ' pb-lookbook__item--wide' -%}{%- endif -%}

        {%- capture inner -%}
          {%- if b.image != blank -%}
            <img
              src="{{ b.image | image_url: width: 900 }}"
              srcset="{{ b.image | image_url: width: 500 }} 500w, {{ b.image | image_url: width: 900 }} 900w, {{ b.image | image_url: width: 1300 }} 1300w"
              sizes="(min-width: 768px) 33vw, 100vw"
              alt="{{ b.image.alt | default: b.title | escape }}"
              width="{{ b.image.width }}" height="{{ b.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'pb-placeholder__svg' }}
          {%- endif -%}
          {%- if b.title != blank or b.eyebrow != blank or b.cta_text != blank -%}
            <div class="pb-lookbook__caption">
              {%- if b.eyebrow != blank -%}<span class="pb-lookbook__eyebrow">{{ b.eyebrow }}</span>{%- endif -%}
              {%- if b.title != blank -%}<div class="pb-lookbook__title">{{ b.title }}</div>{%- endif -%}
              {%- if b.cta_text != blank and b.link != blank -%}
                <span class="pb-lookbook__link pb-link-arrow" style="color: var(--pb-soft-orange);">{{ b.cta_text }} {%- render 'icon-arrow' -%}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- if b.link != blank -%}
          <a href="{{ b.link }}" class="{{ item_class }}" {{ block.shopify_attributes }}>{{ inner }}</a>
        {%- else -%}
          <div class="{{ item_class }}" {{ block.shopify_attributes }}>{{ inner }}</div>
        {%- endif -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pb-lookbook__item"><div class="pb-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear the Message" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Styled for the city, the court, and the ones becoming beloved." },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "black", "label": "Black" }
      ],
      "default": "black"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow / caption label" },
        { "type": "text", "id": "title", "label": "Caption title" },
        { "type": "text", "id": "cta_text", "label": "CTA text" },
        { "type": "url", "id": "link", "label": "Link (product or page)" },
        {
          "type": "select", "id": "size", "label": "Tile size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "tall", "label": "Tall" },
            { "value": "wide", "label": "Wide" }
          ],
          "default": "normal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook grid",
      "blocks": [
        { "type": "image", "settings": { "size": "tall", "eyebrow": "Court Ready", "title": "The Warm-Up Set" } },
        { "type": "image", "settings": { "size": "normal", "eyebrow": "City Layer", "title": "Beloved Hoodie" } },
        { "type": "image", "settings": { "size": "normal", "eyebrow": "Everyday", "title": "Peace Tee" } },
        { "type": "image", "settings": { "size": "wide", "eyebrow": "Off Duty", "title": "The Full Fit" } }
      ]
    }
  ]
}
{% endschema %}
