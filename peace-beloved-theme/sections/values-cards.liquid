{%- comment -%} Peace Beloved — Values cards {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container">
    {%- if s.heading != blank or s.eyebrow != blank -%}
      <div class="pb-section__head pb-section__head--center pb-reveal">
        {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="pb-values">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="pb-value-card pb-scheme-{{ b.card_scheme }} pb-reveal" {{ block.shopify_attributes }}>
          <span class="pb-value-card__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }} — {{ b.label | default: b.heading }}</span>
          {%- if b.heading != blank -%}<h3 class="pb-value-card__title">{{ b.heading }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<p class="pb-value-card__text">{{ b.text }}</p>{%- endif -%}
          {%- if b.link_label != blank and b.link != blank -%}
            <a href="{{ b.link }}" class="pb-value-card__link pb-link-arrow">{{ b.link_label }} {%- render 'icon-arrow' -%}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Values cards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What We Stand For" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Peace. Beloved. Transformation." },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Peace" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Clothing rooted in calm confidence, self-respect, and purpose." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "card_scheme", "label": "Card color",
          "options": [
            { "value": "blue", "label": "Royal blue" },
            { "value": "orange", "label": "Orange" },
            { "value": "black", "label": "Black" },
            { "value": "cream", "label": "Cream" },
            { "value": "dark-blue", "label": "Dark blue" }
          ],
          "default": "blue"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values cards",
      "blocks": [
        { "type": "value", "settings": { "heading": "Peace", "text": "Clothing rooted in calm confidence, self-respect, and purpose.", "card_scheme": "blue" } },
        { "type": "value", "settings": { "heading": "Beloved", "text": "A reminder that value does not come from outside approval.", "card_scheme": "orange" } },
        { "type": "value", "settings": { "heading": "Transformation", "text": "Taking what was overlooked and making it impossible to ignore.", "card_scheme": "black" } }
      ]
    }
  ]
}
{% endschema %}
