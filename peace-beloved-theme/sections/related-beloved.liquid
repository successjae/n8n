{%- comment -%}
  Peace Beloved — Related products.
  Uses Shopify product recommendations when available, otherwise falls back to
  products from the same collection. No hard-coded products.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign limit = s.product_limit

  assign related = null
  if recommendations.performed and recommendations.products_count > 0
    assign related = recommendations.products
  elsif product.collections.first != blank
    assign related = product.collections.first.products
  endif
-%}

<section
  class="pb-section pb-scheme-{{ s.background_scheme }}"
  data-related
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
>
  <div class="pb-container">
    <div class="pb-section__head pb-section__head--center pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
    </div>

    {%- if related != blank and related.size > 0 -%}
      <div class="pb-product-grid">
        {%- assign shown = 0 -%}
        {%- for related_product in related -%}
          {%- if related_product.id != product.id and shown < limit -%}
            {%- render 'product-card-beloved', product: related_product -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the Fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Love" },
    {
      "type": "range", "id": "product_limit", "label": "Products to show",
      "min": 2, "max": 8, "step": 1, "default": 4
    },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "black", "label": "Black" }
      ],
      "default": "white"
    }
  ]
}
{% endschema %}
