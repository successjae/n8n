{%- comment -%} Peace Beloved — Brand manifesto (split screen) {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign split_class = 'pb-split'
  if s.image_position == 'right'
    assign split_class = split_class | append: ' pb-split--media-right'
  endif
-%}

<section class="pb-scheme-{{ s.background_scheme }}" style="--pb-accent: {{ s.accent_color }};">
  <div class="{{ split_class }}">
    <div class="pb-split__media">
      {%- if s.image != blank -%}
        <img
          src="{{ s.image | image_url: width: 1000 }}"
          srcset="{{ s.image | image_url: width: 600 }} 600w, {{ s.image | image_url: width: 1000 }} 1000w, {{ s.image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 768px) 50vw, 100vw"
          alt="{{ s.image.alt | default: s.heading | escape }}"
          width="{{ s.image.width }}" height="{{ s.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'pb-placeholder__svg' }}
      {%- endif -%}
    </div>

    <div class="pb-split__body pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<div class="pb-rte pb-lead" style="margin-top: var(--pb-space-m);">{{ s.body }}</div>{%- endif -%}
      {%- if s.quote != blank -%}
        <blockquote class="pb-split__quote" style="border-color: {{ s.accent_color }};">{{ s.quote }}</blockquote>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="pb-split__actions">
          {%- render 'button-beloved', label: s.button_label, url: s.button_link, style: s.button_style, arrow: true -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand manifesto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_position", "label": "Image position",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Message" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the Ones Who Became Beloved" },
    {
      "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>Peace Beloved is more than clothing. It is a statement of transformation. Every piece carries the reminder that what was overlooked, counted out, or misunderstood can still become chosen, elevated, and beloved.</p>"
    },
    { "type": "text", "id": "quote", "label": "Pull quote", "default": "From overlooked to iconic." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read Our Story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "button_style", "label": "Button style",
      "options": [
        { "value": "primary", "label": "Orange" },
        { "value": "dark", "label": "Dark" },
        { "value": "blue", "label": "Blue" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "dark"
    },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" },
        { "value": "blue", "label": "Royal blue" },
        { "value": "dark-blue", "label": "Dark blue" }
      ],
      "default": "cream"
    },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#F58426" }
  ],
  "presets": [{ "name": "Brand manifesto" }]
}
{% endschema %}
