{%- comment -%} Peace Beloved — Instagram / community gallery {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ig_url = s.instagram_url | default: settings.social_instagram
  assign cta_link = s.cta_link | default: ig_url
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container pb-container--wide">
    <div class="pb-section__head pb-section__head--center pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="pb-section__subhead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="pb-ig-grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign link = b.link | default: ig_url -%}
        <a href="{{ link }}" class="pb-ig-item pb-reveal" target="_blank" rel="noopener" {{ block.shopify_attributes }} aria-label="{{ b.caption | default: 'Instagram' | escape }}">
          {%- if b.image != blank -%}
            <img
              src="{{ b.image | image_url: width: 500 }}"
              srcset="{{ b.image | image_url: width: 300 }} 300w, {{ b.image | image_url: width: 500 }} 500w"
              sizes="(min-width: 768px) 25vw, 50vw"
              alt="{{ b.caption | default: 'Peace Beloved community' | escape }}"
              width="{{ b.image.width }}" height="{{ b.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'pb-placeholder__svg' }}
          {%- endif -%}
          <span class="pb-ig-item__overlay" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" width="28" height="28"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </span>
        </a>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="pb-ig-item"><div class="pb-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if s.cta_label != blank -%}
      <div class="pb-ig__foot">
        {%- render 'button-beloved', label: s.cta_label, url: cta_link, style: 'secondary', arrow: true -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen in the City" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tag @PeaceBelovedClothing to be featured." },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL", "info": "Falls back to the global Instagram URL in theme settings." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Follow @PeaceBelovedClothing" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption / alt text" },
        { "type": "url", "id": "link", "label": "Link", "info": "Falls back to the Instagram URL." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
