{%- comment -%} Peace Beloved — Product story {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign grid_class = 'pb-story__grid'
  if s.image_position == 'right'
    assign grid_class = grid_class | append: ' pb-story__grid--media-right'
  endif

  comment
    Optional metafield override — lets each product tell its own story
    without editing the section. Falls back to section settings.
  endcomment
  assign story_heading = s.heading
  assign story_body = s.body
  if s.use_metafields
    if product.metafields.custom.story_heading != blank
      assign story_heading = product.metafields.custom.story_heading
    endif
    if product.metafields.custom.story_body != blank
      assign story_body = product.metafields.custom.story_body
    endif
  endif
  assign story_image = s.image
  if s.use_metafields and product.metafields.custom.story_image != blank
    assign story_image = product.metafields.custom.story_image
  endif
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container">
    <div class="{{ grid_class }}">
      <div class="pb-story__media pb-reveal">
        {%- if story_image != blank -%}
          <img
            src="{{ story_image | image_url: width: 900 }}"
            srcset="{{ story_image | image_url: width: 500 }} 500w, {{ story_image | image_url: width: 900 }} 900w"
            sizes="(min-width: 768px) 45vw, 100vw"
            alt="{{ story_image.alt | default: story_heading | escape }}"
            width="{{ story_image.width }}" height="{{ story_image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pb-placeholder__svg' }}
        {%- endif -%}
      </div>

      <div class="pb-reveal">
        {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if story_heading != blank -%}<h2>{{ story_heading }}</h2>{%- endif -%}
        {%- if s.accent_text != blank -%}<p class="pb-lead pb-story__accent">{{ s.accent_text }}</p>{%- endif -%}
        {%- if story_body != blank -%}<div class="pb-rte" style="margin-top: var(--pb-space-m);">{{ story_body }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="pb-story__list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bullet' -%}
                <li class="pb-story__list-item" {{ block.shopify_attributes }}>
                  <span class="pb-story__bullet" aria-hidden="true">&#9679;</span>
                  <span>
                    {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong> — {% endif -%}
                    {{ block.settings.text }}
                  </span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Meaning" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Story Behind the Piece" },
    { "type": "text", "id": "accent_text", "label": "Accent line", "default": "Every thread carries the message." },
    {
      "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>This piece was designed for the ones who kept going. Built from premium materials and finished with intention, it carries the reminder that what was once overlooked can become beloved. Wear it as a statement — of peace, of resilience, of becoming.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_position", "label": "Image position",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    {
      "type": "checkbox", "id": "use_metafields", "label": "Use product metafields when available",
      "info": "Reads custom.story_heading, custom.story_body, custom.story_image so each product can tell its own story.",
      "default": true
    },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" },
        { "value": "gray", "label": "Warm gray" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Label" },
        { "type": "text", "id": "text", "label": "Text", "default": "Premium heavyweight cotton, built to last." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product story",
      "blocks": [
        { "type": "bullet", "settings": { "title": "Material", "text": "Premium heavyweight cotton, built to last." } },
        { "type": "bullet", "settings": { "title": "Fit", "text": "Relaxed streetwear silhouette." } },
        { "type": "bullet", "settings": { "title": "Meaning", "text": "A wearable reminder: from overlooked to iconic." } }
      ]
    }
  ]
}
{% endschema %}
