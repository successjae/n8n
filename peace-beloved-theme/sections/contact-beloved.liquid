{%- comment -%} Peace Beloved — Contact {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container">
    <div class="pb-section__head pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1>{{ s.heading }}</h1>{%- endif -%}
      {%- if s.statement != blank -%}<p class="pb-section__subhead">{{ s.statement }}</p>{%- endif -%}
    </div>

    <div class="pb-contact">
      {%- comment -%} Form {%- endcomment -%}
      <div class="pb-reveal">
        {%- form 'contact', id: 'ContactForm', class: 'pb-inline-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="pb-form-message pb-form-message--success" role="status">{{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="pb-form-message pb-form-message--error" role="alert">
              {{ 'contact.error' | t }}
              <ul style="margin-top:6px; padding-left:1.2em;">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </p>
          {%- endif -%}

          <div class="pb-grid pb-grid--2">
            <div class="pb-field">
              <label class="pb-label" for="ContactName">{{ 'contact.name' | t }}</label>
              <input class="pb-input" type="text" id="ContactName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
            </div>
            <div class="pb-field">
              <label class="pb-label" for="ContactEmail">{{ 'contact.email' | t }} *</label>
              <input class="pb-input" type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required aria-required="true">
            </div>
          </div>

          <div class="pb-field">
            <label class="pb-label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
            <input class="pb-input" type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          <div class="pb-field">
            <label class="pb-label" for="ContactMessage">{{ 'contact.message' | t }} *</label>
            <textarea class="pb-textarea" id="ContactMessage" name="contact[body]" required aria-required="true">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="pb-btn pb-btn--primary pb-btn--large">{{ 'contact.send' | t }}</button>
        {%- endform -%}
      </div>

      {%- comment -%} Aside {%- endcomment -%}
      <aside class="pb-contact__aside pb-reveal">
        {%- if s.support_heading != blank -%}
          <div>
            <h2 class="pb-footer__col-title" style="color: var(--pb-orange);">{{ s.support_heading }}</h2>
            <div class="pb-rte">{{ s.support_text }}</div>
          </div>
        {%- endif -%}

        {%- if s.email != blank or s.hours != blank -%}
          <div>
            {%- if s.email != blank -%}<p><strong>{{ 'contact.email' | t }}:</strong> <a href="mailto:{{ s.email }}" style="color:var(--pb-blue);">{{ s.email }}</a></p>{%- endif -%}
            {%- if s.hours != blank -%}<p><strong>{{ 'contact.hours' | t }}:</strong> {{ s.hours }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        <div>
          <h2 class="pb-footer__col-title" style="color: var(--pb-orange);">{{ 'contact.follow' | t }}</h2>
          <div class="pb-mobile-nav__social" style="justify-content:flex-start;">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" style="color:var(--pb-blue);">Instagram</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" style="color:var(--pb-blue);">TikTok</a>{%- endif -%}
            {%- if settings.social_twitter != blank -%}<a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" style="color:var(--pb-blue);">X</a>{%- endif -%}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Peace Beloved" },
    { "type": "textarea", "id": "statement", "label": "Statement", "default": "Questions about a drop, an order, or the movement? We're here." },
    { "type": "header", "content": "Support details" },
    { "type": "text", "id": "support_heading", "label": "Support heading", "default": "Customer Service" },
    { "type": "richtext", "id": "support_text", "label": "Support text", "default": "<p>We reply to every message within 1–2 business days. For order help, include your order number.</p>" },
    { "type": "text", "id": "email", "label": "Support email", "default": "hello@peacebelovedclothing.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9am–5pm EST" },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
