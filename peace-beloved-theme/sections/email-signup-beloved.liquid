{%- comment -%} Peace Beloved — Newsletter signup (native customer form) {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }} pb-signup">
  <div class="pb-container">
    <div class="pb-signup__inner pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="pb-section__subhead">{{ s.text }}</p>{%- endif -%}

      {%- form 'customer', class: 'pb-signup__form', id: 'BelovedSignup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, beloved-list">
        <input type="hidden" name="contact[email_marketing_consent]" value="subscribed">

        {%- if form.posted_successfully? -%}
          <p class="pb-form-message pb-form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="pb-form-message pb-form-message--error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}

        <div class="pb-signup__row">
          <label class="pb-visually-hidden" for="BelovedSignupEmail">{{ 'newsletter.email_label' | t }}</label>
          <input
            class="pb-input"
            type="email"
            id="BelovedSignupEmail"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'newsletter.email_placeholder' | t }}"
            autocomplete="email"
            required
            aria-required="true"
          >
          <button type="submit" class="pb-btn pb-btn--{{ s.button_style }} pb-btn--large">{{ s.button_label }}</button>
        </div>
        <p style="margin-top: var(--pb-space-s); font-size: var(--pb-fs-small); opacity: 0.75;">{{ s.fine_print }}</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Beloved List" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Get first access to new drops, private releases, restocks, and exclusive brand updates." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get First Access" },
    {
      "type": "select", "id": "button_style", "label": "Button style",
      "options": [
        { "value": "primary", "label": "Orange" },
        { "value": "dark", "label": "Dark" },
        { "value": "blue", "label": "Blue" }
      ],
      "default": "dark"
    },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "No spam. Unsubscribe anytime." },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "blue", "label": "Royal blue" },
        { "value": "orange", "label": "Orange" },
        { "value": "black", "label": "Black" },
        { "value": "dark-blue", "label": "Dark blue" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "blue"
    }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
