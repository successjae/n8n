{%- comment -%} Peace Beloved — Featured drop (collection products) {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign collection = collections[s.collection]
  assign limit = s.product_limit
  assign layout_class = 'pb-product-grid'
  if s.layout == 'carousel'
    assign layout_class = 'pb-carousel'
  endif
-%}

<section class="pb-section pb-scheme-{{ s.background_scheme }}">
  <div class="pb-container">
    <div class="pb-section__head pb-section__head--center pb-reveal">
      {%- if s.eyebrow != blank -%}<span class="pb-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="pb-section__subhead">{{ s.subheading }}</p>{%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="{{ layout_class }}">
        {%- for product in collection.products limit: limit -%}
          {%- render 'product-card-beloved',
            product: product,
            badge: s.badge_text,
            quick_add: s.quick_add,
            hover_image: s.hover_image
          -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Theme editor onboarding / empty state {%- endcomment -%}
      <div class="{{ layout_class }}">
        {%- for i in (1..4) -%}
          <article class="pb-card">
            <div class="pb-card__media">
              {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'pb-placeholder__svg' }}
            </div>
            <div class="pb-card__body">
              <h3 class="pb-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="pb-price"><span class="pb-price__regular">{{ 1999 | money }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <div class="pb-featured__foot">
        {%- assign btn_url = s.button_link -%}
        {%- if btn_url == blank and collection != blank -%}{%- assign btn_url = collection.url -%}{%- endif -%}
        {%- render 'button-beloved', label: s.button_label, url: btn_url, style: 'dark', size: 'large', arrow: true -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured drop",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The NYPB Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Premium pieces built with court energy, city attitude, and beloved identity." },
    {
      "type": "range", "id": "product_limit", "label": "Products to show",
      "min": 2, "max": 12, "step": 1, "default": 4
    },
    { "type": "text", "id": "badge_text", "label": "Product badge text", "info": "Applied to every card. Leave blank for automatic sale/sold-out badges." },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [ { "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Carousel" } ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "quick_add", "label": "Enable quick add", "default": true },
    { "type": "checkbox", "id": "hover_image", "label": "Show hover image", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Collection" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the selected collection." },
    {
      "type": "select", "id": "background_scheme", "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "gray", "label": "Warm gray" },
        { "value": "black", "label": "Black" }
      ],
      "default": "white"
    }
  ],
  "presets": [{ "name": "Featured drop" }]
}
{% endschema %}
