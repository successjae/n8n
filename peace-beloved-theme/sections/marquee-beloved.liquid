{%- comment -%} Peace Beloved — Scrolling marquee {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign phrases = s.phrases | newline_to_br | split: '<br />'
  assign marquee_class = 'pb-marquee'
  if s.direction == 'right'
    assign marquee_class = marquee_class | append: ' pb-marquee--reverse'
  endif
-%}

<div
  class="{{ marquee_class }}"
  data-pause="{{ s.pause_on_hover }}"
  style="
    background-color: {{ s.background }};
    color: {{ s.text_color }};
    --pb-marquee-duration: {{ s.speed }}s;
  "
  aria-hidden="true"
>
  {%- comment -%} Track duplicated twice for a seamless -50% loop {%- endcomment -%}
  <div class="pb-marquee__track" aria-hidden="false">
    {%- for i in (1..2) -%}
      {%- for phrase in phrases -%}
        {%- assign clean = phrase | strip -%}
        {%- if clean != blank -%}
          <span class="pb-marquee__item">
            {{ clean }}
            <span class="pb-marquee__dot" aria-hidden="true">&bull;</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "phrases",
      "label": "Phrases",
      "info": "One phrase per line",
      "default": "Peace Beloved\nTake the unloved and make it beloved\nWear the Message\nFrom overlooked to iconic"
    },
    {
      "type": "range", "id": "speed", "label": "Scroll duration",
      "min": 10, "max": 80, "step": 2, "unit": "s", "default": 34
    },
    {
      "type": "select", "id": "direction", "label": "Direction",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ],
      "default": "left"
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "color", "id": "background", "label": "Background", "default": "#F58426" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#101010" }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
